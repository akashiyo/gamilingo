// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id          Int      @id @default(autoincrement())
  en          String
  fr          String
  category    Int      @default(1) // 1, 2, 3
  definition  String?
  img         Bytes?   // Image = donnée binaire.
  theme       String?
}

model User {
  id              Int @id @default(autoincrement())
  name            String
  username        String 
  pwd             String
  level           Int      @default(1)
  role            String
}

model Dragon {
  id  Int @id @default(autoincrement())
  name String
}