generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id         Int     @id @default(autoincrement())
  en         String
  fr         String
  category   Int     @default(1)
  definition String?
  img        Bytes?
  theme      String?
  wordStatus  UserWordStatus[]
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String
  pwd      String
  level    Int    @default(1)
  role     String
  email    String
  img      Bytes?
  xp       Int    @default(0)
  wordStatus UserWordStatus[]
}

model Dragon {
  id   Int    @id @default(autoincrement())
  name String
}

model UserWordStatus {
  id        Int     @id @default(autoincrement())
  userId    Int
  wordId    Int
  known     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  word      Word     @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId]) // Ensures one status per word per user
}
