generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id         Int              @id @default(autoincrement())
  en         String
  fr         String
  category   Int              @default(1)
  definition String?
  img        Bytes?
  theme      String?
  wordStatus UserWordStatus[]
}

model User {
  id         Int              @id @default(autoincrement())
  name       String
  username   String
  pwd        String
  level      Int              @default(1)
  role       String
  email      String
  img        Bytes?
  xp         Int              @default(0)
  avatar     Avatar?
  userAwards UserAward[]
  wordStatus UserWordStatus[]
}

model Dragon {
  id   Int    @id @default(autoincrement())
  name String
}

model UserWordStatus {
  id        Int      @id @default(autoincrement())
  userId    Int
  wordId    Int
  known     Boolean  @default(false)
  wins      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word      Word     @relation(fields: [wordId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, wordId])
}

model UserAward {
  id        Int      @id @default(autoincrement())
  userId    Int
  game      String
  level     Int
  theme     String?
  xp        Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, game, level, theme])
}

model Avatar {
  id     Int     @id @default(autoincrement())
  eyes   String
  mouth  String
  ears   String
  hair   String
  hat    String?
  top    String
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
}
