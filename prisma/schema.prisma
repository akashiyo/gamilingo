generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma" // replace improts by @prisma/client
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id         Int     @id @default(autoincrement())
  en         String
  fr         String
  category   Int     @default(1)
  definition String?
  img        Bytes?
  // imgType    String? // mime type variable
  theme      String?
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String
  pwd      String
  level    Int    @default(1)
  role     String
}

model Dragon {
  id   Int    @id @default(autoincrement())
  name String
}
