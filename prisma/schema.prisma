generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Word {
  id         Int     @id @default(autoincrement())
  en         String
  fr         String
  category   Int     @default(1)
  definition String?
  img        Bytes?
  theme      String?
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  username String
  pwd      String
  level    Int    @default(1)
  role     String
  email    String
  img      Bytes?
  xp       Int    @default(0)
}

model Dragon {
  id   Int    @id @default(autoincrement())
  name String
}
